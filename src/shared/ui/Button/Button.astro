---
import "./Button.css";

export interface Props {
  variant?: "primary" | "secondary" | "ghost" | "success";
  size?: "sm" | "md" | "lg";
  href?: string;
  type?: "button" | "submit" | "reset";
  target?: string;
  rel?: string;
  id?: string;
  disabled?: boolean;
  class?: string;
}

const {
  variant = "primary",
  size = "md",
  href,
  type = "button",
  target,
  rel,
  id,
  disabled = false,
  class: className,
} = Astro.props;

const Tag = href ? "a" : "button";
---

<Tag
  class:list={["btn", `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  type={href ? undefined : type}
  target={target}
  rel={rel}
  id={id}
  disabled={href ? undefined : disabled}
>
  <slot />
</Tag>
