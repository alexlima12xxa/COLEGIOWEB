---
import "../../styles/global.css";
import SEOHead from "./SEOHead.astro";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, image, path, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      path={path}
      noindex={noindex}
    />
  </head>
  <body>
    <slot />
  </body>
</html>
