---
import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SEOHead from "./SEOHead.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import "./BaseLayout.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, image, path, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      path={path}
      noindex={noindex}
    />
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>
  <body class="baseLayout">
    <a href="#main-content" class="uSkipLink">Saltar al contenido principal</a>

    <Navbar />

    <main id="main-content" class="baseLayout__main" tabindex="-1">
      <slot name="top" />
      <slot />
      <slot name="bottom" />
    </main>

    <Footer />
  </body>
</html>
