---
import "../../styles/global.css";
import { ClientRouter } from "astro:transitions";
import SEOHead from "./SEOHead.astro";
import Navbar from "./Navbar.astro";
import Footer from "./Footer.astro";
import "./BaseLayout.css";

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  path?: string;
  noindex?: boolean;
}

const { title, description, image, path, noindex } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <SEOHead
      title={title}
      description={description}
      image={image}
      path={path}
      noindex={noindex}
    />
    <link
      rel="preload"
      href="/fonts/inter/InterVariable.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <slot name="head" />
    <ClientRouter fallback="swap" />
  </head>
  <body class="baseLayout">
    <a href="#main-content" class="uSkipLink">Saltar al contenido principal</a>

    <Navbar />

    <main id="main-content" class="baseLayout__main" tabindex="-1">
      <slot name="top" />
      <slot />
      <slot name="bottom" />
    </main>

    <Footer />

    <script>
      // Netlify Identity envía los enlaces de invitación/recuperación a la raíz
      // del sitio con el token en el hash (#invite_token=...). El widget vive
      // en /admin, así que aquí solo se carga si la URL trae un token: así se
      // intercepta el flujo en cualquier página y se redirige a /admin.
      const identityToken = /(?:invite_token|recovery_token|confirmation_token)=/.test(
        window.location.hash,
      );

      if (identityToken) {
        const script = document.createElement("script");
        script.src =
          "https://identity.netlify.com/v1/netlify-identity-widget.js";
        script.onload = () => {
          window.netlifyIdentity.init({
            APIUrl: "https://coegioweb.netlify.app/.netlify/identity",
          });
          window.netlifyIdentity.on("login", () => {
            window.location.href = "/admin";
          });
        };
        document.head.appendChild(script);
      }
    </script>
  </body>
</html>
