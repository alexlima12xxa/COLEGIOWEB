---
import BaseLayout from "../shared/layouts/BaseLayout.astro";
import Section from "../shared/ui/Section/Section.astro";
import Button from "../shared/ui/Button/Button.astro";
import Card from "../shared/ui/Card/Card.astro";
import Badge from "../shared/ui/Badge/Badge.astro";
import VideoModal from "../shared/ui/VideoModal/VideoModal.astro";
import ResponsiveImage from "../shared/ui/ResponsiveImage/ResponsiveImage.astro";
import { siteConfig } from "../site.config";
import homeData from "../data/fallback/home.json";

const enabledLevels = siteConfig.levels.filter((level) => level.enabled).slice(0, 3);
const tourPoster = siteConfig.branding.assets.tourVideoPoster || "/branding/og-image.svg";
const heroPhoto = siteConfig.branding.assets.heroPhoto || "/branding/placeholders/hero-photo.jpg";
---

<BaseLayout
  title="Inicio"
  description={siteConfig.identity.shortDescription || siteConfig.seo.defaultDescription}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={heroPhoto}
    fetchpriority="high"
  />

  <Section padding="xl" class="homeHero">
    <div class="homeHero__grid">
      <div class="homeHero__content">
        <Badge variant="primary">{siteConfig.admissions.periodLabel}</Badge>
        <h1 class="homeHero__title">
          {siteConfig.identity.name}
        </h1>
        <p class="homeHero__lead">{siteConfig.identity.slogan}</p>
        <p class="homeHero__description">
          {siteConfig.identity.description}
        </p>
        <div class="homeHero__actions">
          <Button href={siteConfig.admissions.ctaUrl} size="lg">
            {siteConfig.admissions.ctaLabel}
          </Button>
          <Button href="/nosotros" variant="secondary" size="lg">
            Conócenos
          </Button>
        </div>
      </div>

      <div class="homeHero__media">
        <div class="homeHero__video">
          <VideoModal
            id="home-tour"
            videoUrl="/branding/tour.mp4"
            poster={tourPoster}
            title="Ver tour virtual"
          />
        </div>
        <div class="homeHero__photo">
          <ResponsiveImage
            src={heroPhoto}
            alt="Estudiantes del Colegio Piloto en actividad académica"
            width={1200}
            height={900}
            loading="eager"
            fetchpriority="high"
            sizes="(min-width: 48rem) 50vw, 100vw"
          />
        </div>
      </div>
    </div>
  </Section>

  <Section padding="md" bg="inverse" class="trustStrip">
    <ul class="trustStrip__list" role="list">
      {
        homeData.metrics.map((metric) => (
          <li class="trustStrip__item">
            <span class="trustStrip__value">{metric.value}</span>
            <span class="trustStrip__label">{metric.label}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section padding="lg">
    <div class="homeSectionHeader">
      <h2 class="homeSectionHeader__title">Niveles educativos</h2>
      <p class="homeSectionHeader__text">
        Ofrecemos una propuesta formativa continua desde la primera infancia
        hasta la educación media.
      </p>
    </div>

    <div class="homeLevels">
      {
        enabledLevels.map((level) => (
          <Card variant="bordered" class="homeLevels__card">
            <Badge variant="primary">{level.shortName}</Badge>
            <h3 class="homeLevels__name">{level.name}</h3>
            <p class="homeLevels__description">{level.description}</p>
            {level.ageRange && (
              <p class="homeLevels__age">{level.ageRange}</p>
            )}
            <div class="homeLevels__action">
              <Button href={`/niveles/${level.slug}`} variant="ghost" size="sm">
                Explorar nivel
              </Button>
            </div>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section padding="lg" bg="muted">
    <div class="homeSectionHeader">
      <h2 class="homeSectionHeader__title">¿Por qué elegirnos?</h2>
      <p class="homeSectionHeader__text">
        Cuatro pilares que definen la experiencia educativa de nuestra
        comunidad escolar.
      </p>
    </div>

    <div class="homeDiferentiators">
      {
        homeData.differentiators.map((item, index) => (
          <article class="homeDiferentiators__item">
            <span class="homeDiferentiators__number" aria-hidden="true">
              0{index + 1}
            </span>
            <h3 class="homeDiferentiators__title">{item.title}</h3>
            <p class="homeDiferentiators__text">{item.description}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section padding="lg">
    <div class="homeSectionHeader">
      <h2 class="homeSectionHeader__title">Momentos que inspiran</h2>
      <p class="homeSectionHeader__text">
        Un vistazo a la vida académica, artística y deportiva de nuestro
        colegio.
      </p>
    </div>

    <div class="homeGallery">
      {
        homeData.bentoGallery.map((photo) => (
          <figure
            class:list={[
              "homeGallery__figure",
              photo.variant && `homeGallery__figure--${photo.variant}`,
            ]}
          >
            <ResponsiveImage
              src={photo.src}
              alt={photo.alt}
              width={800}
              height={800}
              loading="lazy"
              sizes="(min-width: 48rem) 33vw, 100vw"
              class="homeGallery__image"
            />
            <figcaption class="uVisuallyHidden">{photo.alt}</figcaption>
          </figure>
        ))
      }
    </div>
  </Section>

  <Section padding="xl" bg="inverse" class="homeCta">
    <div class="homeCta__content">
      <h2 class="homeCta__title">Sé parte de la comunidad Colegio Piloto</h2>
      <p class="homeCta__text">
        Inicia el proceso de admisiones 2026 y descubre todo lo que podemos
        ofrecer a tu familia.
      </p>
      <div class="homeCta__actions">
        <Button href="/admisiones" size="lg">
          Iniciar admisión
        </Button>
        <Button href="/contacto" variant="secondary" size="lg">
          Hablar con admisiones
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .homeHero__grid {
    display: grid;
    gap: var(--space-xl);
    align-items: center;
  }

  @media (min-width: 48rem) {
    .homeHero__grid {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-2xl);
    }
  }

  .homeHero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-md);
    min-width: 0;
  }

  .homeHero__title {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
    color: var(--color-text);
  }

  @media (min-width: 48rem) {
    .homeHero__title {
      font-size: var(--text-5xl);
    }
  }

  .homeHero__lead {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
  }

  .homeHero__description {
    color: var(--color-text-muted);
    max-width: 50ch;
  }

  .homeHero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }

  .homeHero__media {
    display: grid;
    gap: var(--space-md);
    min-width: 0;
  }

  @media (min-width: 64rem) {
    .homeHero__media {
      grid-template-columns: 1.2fr 0.8fr;
      align-items: stretch;
    }
  }

  .homeHero__video,
  .homeHero__photo {
    min-width: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
  }

  .homeHero__photo img {
    width: 100%;
    max-width: 100%;
    height: auto;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  .trustStrip__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .trustStrip__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .trustStrip__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trustStrip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-xs);
    min-width: 0;
  }

  .trustStrip__value {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
  }

  .trustStrip__label {
    font-size: var(--text-sm);
    color: var(--color-text-inverse);
    opacity: 0.85;
  }

  .homeSectionHeader {
    max-width: 55ch;
    margin-bottom: var(--space-xl);
  }

  .homeSectionHeader__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-sm);
  }

  @media (min-width: 48rem) {
    .homeSectionHeader__title {
      font-size: var(--text-3xl);
    }
  }

  .homeSectionHeader__text {
    color: var(--color-text-muted);
  }

  .homeLevels {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .homeLevels {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .homeLevels__card {
    min-width: 0;
  }

  .homeLevels__name {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
  }

  .homeLevels__description {
    color: var(--color-text-muted);
    flex: 1 1 auto;
  }

  .homeLevels__age {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
  }

  .homeLevels__action {
    margin-top: auto;
  }

  .homeDiferentiators {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 40rem) {
    .homeDiferentiators {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .homeDiferentiators {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .homeDiferentiators__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }

  .homeDiferentiators__number {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .homeDiferentiators__title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
  }

  .homeDiferentiators__text {
    color: var(--color-text-muted);
    word-break: break-words;
  }

  .homeGallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 48rem) {
    .homeGallery {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: minmax(12rem, auto);
    }
  }

  .homeGallery__figure {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-width: 0;
  }

  .homeGallery__figure img {
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 48rem) {
    .homeGallery__figure--large {
      grid-column: span 2;
      grid-row: span 2;
    }

    .homeGallery__figure--large img {
      aspect-ratio: 1 / 1;
    }

    .homeGallery__figure--tall {
      grid-row: span 2;
    }

    .homeGallery__figure--tall img {
      aspect-ratio: 3 / 4;
    }

    .homeGallery__figure--wide {
      grid-column: span 2;
    }

    .homeGallery__figure--wide img {
      aspect-ratio: 16 / 9;
    }
  }

  .homeCta__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
    max-width: 60ch;
    margin-inline: auto;
  }

  .homeCta__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-inverse);
  }

  @media (min-width: 48rem) {
    .homeCta__title {
      font-size: var(--text-3xl);
    }
  }

  .homeCta__text {
    color: var(--color-text-inverse);
    opacity: 0.85;
  }

  .homeCta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }
</style>
