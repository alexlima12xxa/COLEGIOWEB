# Supabase (ver el proyecto real en supabase.com)
NEXT_PUBLIC_SUPABASE_URL=https://<proyecto>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# URL pública del panel admin. Se usa para construir los enlaces de los correos
# de Supabase Auth (invitación / recuperación de contraseña) y como fallback de
# redirectTo en la provisión de colegios. Sin barra final.
NEXT_PUBLIC_APP_URL=https://admin.yachay-ia.com

# Rebuild de la web SSG (GATE A8)
# URL del Deploy Hook de Vercel del proyecto web (Settings → Git → Deploy Hooks).
# Se llama tras cada guardado de contenido para re-construir la web en <5 min.
# Si no se define, el panel funciona pero la web no se actualiza automáticamente.
REBUILD_HOOK_URL=https://api.vercel.com/v1/integrations/deploy/<project-id>/<hook-id>

# Vista previa híbrida de banners (iframe → motor real de Astro)
# URL base del proyecto web. El token de acceso se firma server-side con
# PREVIEW_SIGNING_KEY (no viaja en NEXT_PUBLIC_*). Si falta la URL o el secreto,
# el preview se desactiva (mensaje informativo en el formulario).
NEXT_PUBLIC_WEB_URL=https://<tu-dominio-web>.com

# Secreto server-only que firma/valida el token de /preview-admin (HMAC, TTL).
# Debe ser idéntico al de apps/web (PREVIEW_SIGNING_KEY).
PREVIEW_SIGNING_KEY=<secreto-largo-al-azar>

# Nota: para restringir qué sitios pueden embeber el preview (frame-ancestors),
# define `ADMIN_ORIGIN` en el entorno de la WEB con el origen de este panel
# (ej. https://admin.tu-colegio.com). Es opcional; ver apps/web/.env.example.

# ── Alta de colegios desde /operador (rol superadmin) ──────────────────────
# SOLO server-side (SIN prefijo NEXT_PUBLIC_): nunca llegan al navegador.
#   SUPABASE_SERVICE_ROLE_KEY  key de servicio para escritura cross-tenant y
#                              la saga de provisión (bypassa RLS).
#   VERCEL_TOKEN               token de la API de Vercel con rol mínimo (crear
#                              proyecto, env, dominio y deploy hook por colegio).
#   VERCEL_TEAM_ID             opcional; solo si el token pertenece a un team.
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>
VERCEL_TOKEN=<token-vercel>
VERCEL_TEAM_ID=<team-id-opcional>