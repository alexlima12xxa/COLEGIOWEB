# ── Supabase (GATE 4) ──────────────────────────────────────────────────────
# La web es SSG: lee el contenido de Supabase SOLO durante el build.
# Si alguna de estas variables falta (o es invalida), el sitio se construye
# con los datos de respaldo de src/data/fallback/ sin errores.
#
# Copia este archivo a .env y completa los valores reales.
# NUNCA commitees claves reales en este archivo: el repo es publico y
# Supabase revoca automaticamente las claves expuestas.

# URL del proyecto Supabase (https://<project-ref>.supabase.co)
PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co

# Anon key (publica, usada en el navegador para el formulario de leads)
PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Service role key (NUNCA debe llegar al navegador; solo build-time)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# UUID del colegio en la tabla colegios (un build por colegio)
PUBLIC_TENANT_ID=<tenant-uuid>
