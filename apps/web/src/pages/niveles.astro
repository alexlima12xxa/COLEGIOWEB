---
import BaseLayout from "../shared/layouts/BaseLayout.astro";
import Section from "../shared/ui/Section/Section.astro";
import LevelCards from "../features/levels/components/LevelCards/LevelCards.astro";
import CampusShowcase from "../features/levels/components/CampusShowcase/CampusShowcase.astro";
import { siteConfig } from "../site.config";
import { getVideoTour, getHero } from "../shared/db/contenido";
import { resolveAssetUrl } from "../shared/db/storage";

const title = "Niveles educativos";
const description =
  "Conoce nuestra oferta académica: preescolar, primaria y secundaria.";

const enabledLevels = siteConfig.levels.filter((level) => level.enabled);

// Video de instalaciones desde Supabase (clave `video_tour`), con fallback a
// site.config y placeholder, igual que el hero de inicio.
const videoTour = await getVideoTour();
const hero = await getHero();

// Placeholder de muestra (modo "ver cómo se ve") hasta que el colegio cargue
// un video real en la clave `video_tour`. Se sustituye automáticamente cuando
// videoTour.data.videoUrl tiene valor.
const PLACEHOLDER_VIDEO =
  "https://commondatastorage.googleapis.com/gtv-videos-bucket/sample/ForBiggerEscapes.mp4";
const PLACEHOLDER_POSTER = "/branding/placeholders/hero-tour-poster.jpg";

const tourVideoUrl = videoTour.data.videoUrl || PLACEHOLDER_VIDEO;
const tourPoster =
  videoTour.data.poster ||
  hero.data.tourPoster ||
  siteConfig.branding.assets.tourVideoPoster ||
  PLACEHOLDER_POSTER;
const tourPosterUrl = resolveAssetUrl(tourPoster) ?? tourPoster;
const tourTitle =
  videoTour.data.title ||
  "Conoce nuestras instalaciones y espacios de aprendizaje";
const hasTourVideo = true;
---

<BaseLayout title={title} description={description}>
  <Section padding="xl" class="levelsIndex">
    <div class="levelsIndex__header">
      <h1 class="levelsIndex__title">Niveles educativos</h1>
      <p class="levelsIndex__lead">
        Una propuesta formativa continua que acompaña el crecimiento de cada
        estudiante desde la primera infancia hasta la educación media.
      </p>
    </div>

    <LevelCards levels={enabledLevels} headingLevel="h2" ctaLabel="Ver nivel" />
  </Section>

  {
    hasTourVideo && (
      <Section padding="none" class="levelsTour">
        <CampusShowcase
          videoUrl={tourVideoUrl}
          poster={tourPosterUrl}
          title={tourTitle}
          badge="Tour Virtual"
        />
      </Section>
    )
  }
</BaseLayout>

<style>
  .levelsIndex__header {
    max-width: 60ch;
    margin-bottom: var(--space-xl);
  }

  .levelsIndex__title {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-md);
  }

  @media (min-width: 48rem) {
    .levelsIndex__title {
      font-size: var(--text-5xl);
    }
  }

  .levelsIndex__lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  /* Espaciado vertical alrededor del banner de instalaciones.
     :global() porque los <section> los renderiza Section.astro, que no lleva el
     data-astro-cid de esta página (mismo caso que .trustStrip en index.astro).
     - .levelsIndex sin padding inferior (las cards pegan justo antes del banner).
     - .levelsTour: 24px arriba (cards↔video) y 64px abajo (video↔footer). */
  :global(.levelsIndex) {
    padding-block-end: 0;
  }

  :global(.levelsTour) {
    padding-block-start: var(--space-lg);
    padding-block-end: var(--space-3xl);
  }

  @media (min-width: 48rem) {
    :global(.levelsTour) {
      padding-block-start: var(--space-lg);
    }
  }
</style>
