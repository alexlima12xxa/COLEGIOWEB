---
import BaseLayout from "../../shared/layouts/BaseLayout.astro";
import NivelLayout from "../../features/levels/components/NivelLayout.astro";
import { siteConfig } from "../../site.config";
import { getNiveles } from "../../shared/db/contenido";

export function getStaticPaths() {
  const slugs = ["preescolar", "primaria", "secundaria"];
  return slugs.map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
const levelConfig = siteConfig.levels.find((l) => l.slug === slug);
const niveles = await getNiveles();
const levelContent = slug ? niveles[slug] : undefined;

if (!levelContent) {
  throw new Error(`Nivel no encontrado: ${slug}`);
}

// El nombre y la edad pueden venir de la DB (contenido["niveles"]), con
// fallback a la config estática del colegio (colegio-piloto.ts).
const levelName = levelContent.name?.trim()
  ? levelContent.name
  : (levelConfig?.name ?? "");
const levelAgeRange = levelContent.ageRange ?? levelConfig?.ageRange;

// Meta description: se deriva de la descripción larga de la página de
// detalle, truncada a ~160 caracteres (límite recomendado de SEO).
const metaDescription =
  levelContent.description.length > 160
    ? `${levelContent.description.slice(0, 157).trimEnd()}…`
    : levelContent.description;

const levelUrl = new URL(
  `/niveles/${slug}/`,
  siteConfig.seo.siteUrl,
).toString();

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: new URL("/", siteConfig.seo.siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Niveles",
      item: new URL("/niveles/", siteConfig.seo.siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: levelName,
      item: levelUrl,
    },
  ],
};
---

<BaseLayout title={levelName} description={metaDescription}>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(breadcrumbJsonLd)}
    is:inline
  />
  <NivelLayout
    name={levelName}
    ageRange={levelAgeRange}
    headline={levelContent.headline}
    description={levelContent.description}
    image={levelContent.image}
    program={levelContent.program}
    methodology={levelContent.methodology}
    schedule={levelContent.schedule}
    cta={levelContent.cta}
    ctaHref={levelContent.ctaHref}
  />
</BaseLayout>
