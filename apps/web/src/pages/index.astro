---
import BaseLayout from "../shared/layouts/BaseLayout.astro";
import Section from "../shared/ui/Section/Section.astro";
import Button from "../shared/ui/Button/Button.astro";
import Card from "../shared/ui/Card/Card.astro";
import Badge from "../shared/ui/Badge/Badge.astro";
import ResponsiveImage from "../shared/ui/ResponsiveImage/ResponsiveImage.astro";
import HomeHero from "../features/home/components/HomeHero/HomeHero.astro";
import { siteConfig } from "../site.config";
import homeData from "../data/fallback/home.json";
import { getHero, getVideoTour, getGaleria } from "../shared/db/contenido";
import { resolveAssetUrl } from "../shared/db/storage";

// Hero y video tour desde Supabase (tabla `contenido`), con fallback a
// site.config. Se resuelven en build-time: un cambio del panel aparece tras
// el rebuild.
const hero = await getHero();
const videoTour = await getVideoTour();
const gallery = await getGaleria();

const heroSlogan = hero.data.slogan || siteConfig.identity.slogan;
const heroDescription =
  hero.data.description ||
  siteConfig.identity.description ||
  siteConfig.identity.shortDescription ||
  "";
const heroPhoto =
  hero.data.heroPhoto ||
  siteConfig.branding.assets.heroPhoto ||
  "/branding/placeholders/hero-photo.jpg";
const tourVideoUrl = videoTour.data.videoUrl || "/branding/tour.mp4";
const tourPoster =
  videoTour.data.poster ||
  hero.data.tourPoster ||
  siteConfig.branding.assets.tourVideoPoster ||
  "/branding/og-image.svg";
// Resuelve rutas relativas de Storage a URLs absolutas (el preload y el
// poster del video NO pasan por ResponsiveImage/ContentImage, que resuelven
// internamente). resolveAssetUrl devuelve tal cual las URLs absolutas.
const heroPhotoUrl = resolveAssetUrl(heroPhoto) ?? heroPhoto;
const tourPosterUrl = resolveAssetUrl(tourPoster) ?? tourPoster;
const tourTitle = videoTour.data.title || "Ver tour virtual";
const periodLabel = siteConfig.admissions.periodLabel;

// Modo de media condicional según lo que el colegio configure en el admin:
// - Foto + Video → heroPhoto como póster con botón Play encima.
// - Solo Foto → heroPhoto limpia (sin botón de Play).
// - Solo Video → póster del tour con botón Play.
// El campo `heroPhoto` del admin se sigue usando al 100%.
const hasVideo = Boolean(videoTour.data?.videoUrl);
const hasPhoto = Boolean(
  hero.data.heroPhoto || siteConfig.branding.assets.heroPhoto,
);
const mediaMode: "photo-video" | "photo-only" | "video-only" =
  hasPhoto && hasVideo ? "photo-video" : hasPhoto ? "photo-only" : "video-only";
// LCP: la imagen que se preloada depende del modo de media.
const lcpImage = mediaMode === "video-only" ? tourPosterUrl : heroPhotoUrl;

const enabledLevels = siteConfig.levels
  .filter((level) => level.enabled)
  .slice(0, 3);

const absoluteUrl = (path: string) =>
  new URL(path, siteConfig.seo.siteUrl).toString();

const videoJsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: `Tour virtual por ${siteConfig.identity.name}`,
  description: `Recorrido virtual por las instalaciones de ${siteConfig.identity.name}: aulas, laboratorios, zonas deportivas y espacios comunes.`,
  thumbnailUrl: absoluteUrl(tourPosterUrl),
  uploadDate: new Date().toISOString(),
  contentUrl: absoluteUrl(tourVideoUrl),
  embedUrl: absoluteUrl("/"),
  publisher: {
    "@type": "School",
    name: siteConfig.identity.name,
    logo: siteConfig.branding.assets.logo
      ? absoluteUrl(siteConfig.branding.assets.logo)
      : undefined,
  },
};
---

<BaseLayout
  title="Inicio"
  description={siteConfig.identity.shortDescription ||
    siteConfig.seo.defaultDescription}
>
  <link
    slot="head"
    rel="preload"
    as="image"
    href={lcpImage}
    fetchpriority="high"
  />

  {
    hasVideo && (
      <script
        slot="head"
        type="application/ld+json"
        set:html={JSON.stringify(videoJsonLd)}
        is:inline
      />
    )
  }

  <HomeHero
    badge={hero.data.badge || periodLabel}
    title={heroSlogan}
    description={heroDescription}
    ctaPrimary={{
      label: siteConfig.admissions.ctaLabel,
      href: siteConfig.admissions.ctaUrl,
    }}
    ctaSecondary={{ label: "Conocer propuesta", href: "#niveles" }}
    mediaMode={mediaMode}
    heroPhoto={heroPhotoUrl}
    heroPhotoAlt={`Estudiantes de ${siteConfig.identity.name} en actividad académica`}
    videoUrl={hasVideo ? tourVideoUrl : undefined}
    videoPoster={tourPosterUrl}
    videoTitle={tourTitle}
  />

  <Section padding="md" bg="inverse" class="trustStrip">
    <ul class="trustStrip__list" role="list">
      {
        homeData.metrics.map((metric) => (
          <li class="trustStrip__item">
            <span class="trustStrip__value">{metric.value}</span>
            <span class="trustStrip__label">{metric.label}</span>
          </li>
        ))
      }
    </ul>
  </Section>

  <Section padding="lg" id="niveles">
    <div class="homeSectionHeader">
      <h2 class="homeSectionHeader__title">Niveles educativos</h2>
      <p class="homeSectionHeader__text">
        Ofrecemos una propuesta formativa continua desde la primera infancia
        hasta la educación media.
      </p>
    </div>

    <div class="homeLevels">
      {
        enabledLevels.map((level) => (
          <Card variant="bordered" class="homeLevels__card">
            <Badge variant="primary">{level.shortName}</Badge>
            <h3 class="homeLevels__name">{level.name}</h3>
            <p class="homeLevels__description">{level.description}</p>
            {level.ageRange && <p class="homeLevels__age">{level.ageRange}</p>}
            <div class="homeLevels__action">
              <Button href={`/niveles/${level.slug}`} variant="ghost" size="sm">
                Explorar nivel
              </Button>
            </div>
          </Card>
        ))
      }
    </div>
  </Section>

  <Section padding="lg" bg="muted">
    <div class="homeSectionHeader">
      <h2 class="homeSectionHeader__title">¿Por qué elegirnos?</h2>
      <p class="homeSectionHeader__text">
        Cuatro pilares que definen la experiencia educativa de nuestra comunidad
        escolar.
      </p>
    </div>

    <div class="homeDiferentiators">
      {
        homeData.differentiators.map((item, index) => (
          <article class="homeDiferentiators__item">
            <span class="homeDiferentiators__number" aria-hidden="true">
              0{index + 1}
            </span>
            <h3 class="homeDiferentiators__title">{item.title}</h3>
            <p class="homeDiferentiators__text">{item.description}</p>
          </article>
        ))
      }
    </div>
  </Section>

  <Section padding="lg">
    <div class="homeSectionHeader">
      <h2 class="homeSectionHeader__title">Momentos que inspiran</h2>
      <p class="homeSectionHeader__text">
        Un vistazo a la vida académica, artística y deportiva de nuestro
        colegio.
      </p>
    </div>

    <div class="homeGallery">
      {
        gallery.map((photo) => (
          <figure
            class:list={[
              "homeGallery__figure",
              photo.variant && `homeGallery__figure--${photo.variant}`,
            ]}
          >
            <ResponsiveImage
              src={photo.src}
              alt={photo.alt}
              width={800}
              height={800}
              loading="lazy"
              sizes="(min-width: 48rem) 33vw, 100vw"
              class="homeGallery__image"
            />
            <figcaption class="uVisuallyHidden">{photo.alt}</figcaption>
          </figure>
        ))
      }
    </div>
  </Section>

  <Section padding="xl" bg="inverse" class="homeCta">
    <div class="homeCta__content">
      <h2 class="homeCta__title">Sé parte de la comunidad Colegio Piloto</h2>
      <p class="homeCta__text">
        Inicia el proceso de admisiones 2026 y descubre todo lo que podemos
        ofrecer a tu familia.
      </p>
      <div class="homeCta__actions">
        <Button href="/admisiones" size="lg"> Iniciar admisión </Button>
        <Button href="/contacto" variant="secondary" size="lg">
          Hablar con admisiones
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .trustStrip__list {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media (min-width: 40rem) {
    .trustStrip__list {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .trustStrip__list {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .trustStrip__item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-xs);
    min-width: 0;
  }

  .trustStrip__value {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    color: var(--color-text-inverse);
  }

  .trustStrip__label {
    font-size: var(--text-sm);
    color: var(--color-text-inverse);
    opacity: 0.85;
  }

  .homeSectionHeader {
    max-width: 55ch;
    margin-bottom: var(--space-xl);
  }

  .homeSectionHeader__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-sm);
  }

  @media (min-width: 48rem) {
    .homeSectionHeader__title {
      font-size: var(--text-3xl);
    }
  }

  .homeSectionHeader__text {
    color: var(--color-text-muted);
  }

  .homeLevels {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-lg);
  }

  @media (min-width: 48rem) {
    .homeLevels {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .homeLevels__card {
    min-width: 0;
  }

  .homeLevels__name {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
  }

  .homeLevels__description {
    color: var(--color-text-muted);
    flex: 1 1 auto;
  }

  .homeLevels__age {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
  }

  .homeLevels__action {
    margin-top: auto;
  }

  .homeDiferentiators {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-xl);
  }

  @media (min-width: 40rem) {
    .homeDiferentiators {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 64rem) {
    .homeDiferentiators {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  .homeDiferentiators__item {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
    min-width: 0;
  }

  .homeDiferentiators__number {
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: var(--font-weight-bold);
    color: var(--color-primary);
  }

  .homeDiferentiators__title {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
  }

  .homeDiferentiators__text {
    color: var(--color-text-muted);
    word-break: break-words;
  }

  .homeGallery {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-md);
  }

  @media (min-width: 48rem) {
    .homeGallery {
      grid-template-columns: repeat(3, 1fr);
      grid-auto-rows: minmax(12rem, auto);
    }
  }

  .homeGallery__figure {
    position: relative;
    margin: 0;
    border-radius: var(--radius-lg);
    overflow: hidden;
    min-width: 0;
  }

  .homeGallery__figure :global(img) {
    width: 100%;
    height: 100%;
    max-width: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  @media (min-width: 48rem) {
    .homeGallery__figure--large {
      grid-column: span 2;
      grid-row: span 2;
    }

    .homeGallery__figure--large :global(img) {
      aspect-ratio: 1 / 1;
    }

    .homeGallery__figure--tall {
      grid-row: span 2;
    }

    .homeGallery__figure--tall :global(img) {
      aspect-ratio: 3 / 4;
    }

    .homeGallery__figure--wide {
      grid-column: span 2;
    }

    .homeGallery__figure--wide :global(img) {
      aspect-ratio: 16 / 9;
    }
  }

  .homeCta__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
    max-width: 60ch;
    margin-inline: auto;
  }

  .homeCta__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-inverse);
  }

  @media (min-width: 48rem) {
    .homeCta__title {
      font-size: var(--text-3xl);
    }
  }

  .homeCta__text {
    color: var(--color-text-inverse);
    opacity: 0.85;
  }

  .homeCta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }
</style>
