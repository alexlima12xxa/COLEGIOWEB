---
import BaseLayout from "../shared/layouts/BaseLayout.astro";
import Section from "../shared/ui/Section/Section.astro";
import Button from "../shared/ui/Button/Button.astro";
import AdmissionsHero from "../features/admissions/components/AdmissionsHero/AdmissionsHero.astro";
import AdmissionsSteps from "../features/admissions/components/AdmissionsSteps/AdmissionsSteps.astro";
import AdmissionsRequirements from "../features/admissions/components/AdmissionsRequirements/AdmissionsRequirements.astro";
import AdmissionsFaq from "../features/admissions/components/AdmissionsFaq/AdmissionsFaq.astro";
import AdmissionForm from "../features/admissions/components/AdmissionForm/AdmissionForm.astro";
import { siteConfig } from "../site.config";
import { getAdmisiones } from "../shared/db/contenido";

const activeLevels = siteConfig.levels.filter((level) => level.enabled);
const supabaseUrl =
  import.meta.env.PUBLIC_SUPABASE_URL || siteConfig.supabase.url;
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
const tenantId = import.meta.env.PUBLIC_TENANT_ID;

const title = "Admisiones";
const description =
  "Proceso de admisiones 2026 del Colegio Piloto: fechas clave, etapas, requisitos por nivel y preguntas frecuentes.";

// Contenido editorial desde Supabase (tabla `contenido`), con fallback local.
// Se resuelve en build-time: un cambio del panel aparece tras el rebuild.
const admissions = await getAdmisiones();

const whatsappNumber = siteConfig.contact.whatsapp.replace(/\D/g, "");

// El año del proceso se deriva del deadline/periodLabel de la config, no
// de la fecha de build: un build en diciembre no puede anunciar "Admisiones
// {año pasado}" junto a "Admisiones 2026 abiertas".
const admissionsYear = siteConfig.admissions.deadline
  ? new Date(siteConfig.admissions.deadline).getFullYear()
  : Number(
      siteConfig.admissions.periodLabel.match(/\d{4}/)?.[0] ??
        new Date().getFullYear(),
    );

// Niveles para las tabs de requisitos: se derivan de siteConfig.levels para
// respetar la config del colegio (orden y etiquetas). Cada nivel mapea a su
// clave en `requisitosPorNivel` (preescolar / primaria / secundaria).
const nivelRequisitos = activeLevels.map((level) => ({
  id: level.id,
  label: level.ageRange ? `${level.name} (${level.ageRange})` : level.name,
  requisitos: admissions.requisitosPorNivel[level.id] ?? [],
}));

const fechaBadge = `Convocatoria ${admissionsYear} Abierta`;

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: admissions.faq.map((item) => ({
    "@type": "Question",
    name: item.title,
    acceptedAnswer: {
      "@type": "Answer",
      text: item.content,
    },
  })),
};
---

<BaseLayout title={title} description={description}>
  <script
    type="application/ld+json"
    set:html={JSON.stringify(faqJsonLd)}
    is:inline
  />

  <AdmissionsHero
    badge={fechaBadge}
    titlePre="El futuro de tus hijos comienza aquí: "
    titleHighlight={`Admisiones ${admissionsYear}`}
    description="Inicia el proceso de admisión para que tu hijo o hija haga parte de nuestra comunidad educativa. Te acompañamos en cada etapa, con un proceso claro, cercano y completamente en línea."
    ctaPrimary={{
      label: "Iniciar Postulación",
      href: siteConfig.admissions.ctaUrl,
    }}
    ctaSecondary={{
      label: "Consultar por WhatsApp",
      href: `https://wa.me/${whatsappNumber}`,
    }}
    fechasClave={admissions.fechasClave}
    aviso={admissions.aviso}
  />

  <AdmissionsSteps etapas={admissions.etapas} />

  <AdmissionsRequirements
    niveles={nivelRequisitos}
    pdfUrl="/requisitos-admisiones-2026.pdf"
  />

  <AdmissionsFaq items={admissions.faq} />

  <Section padding="xl" bg="muted" id="formulario">
    <AdmissionForm
      whatsapp={siteConfig.contact.whatsapp}
      schoolName={siteConfig.identity.name}
      levels={activeLevels}
      supabaseUrl={supabaseUrl}
      supabaseAnonKey={supabaseAnonKey}
      tenantId={tenantId}
      privacyUrl="/aviso-de-privacidad"
    />
  </Section>

  <Section padding="xl" bg="inverse" class="admissionsCta">
    <div class="admissionsCta__content">
      <h2 class="admissionsCta__title">¿Tienes dudas sobre el proceso?</h2>
      <p class="admissionsCta__text">
        Nuestro equipo de admisiones está listo para ayudarte.
      </p>
      <div class="admissionsCta__actions">
        <Button href="#formulario" size="lg"> Solicitar información </Button>
        <Button
          href={`https://wa.me/${whatsappNumber}`}
          variant="secondary"
          size="lg"
          target="_blank"
          rel="noopener noreferrer"
        >
          Escribir por WhatsApp
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .admissionsCta__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: var(--space-md);
    max-width: 60ch;
    margin-inline: auto;
  }

  .admissionsCta__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    color: var(--color-text-inverse);
  }

  @media (min-width: 48rem) {
    .admissionsCta__title {
      font-size: var(--text-3xl);
    }
  }

  .admissionsCta__text {
    color: var(--color-text-inverse);
    opacity: 0.85;
  }

  .admissionsCta__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-md);
    margin-top: var(--space-sm);
  }
</style>
