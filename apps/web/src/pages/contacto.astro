---
import BaseLayout from "../shared/layouts/BaseLayout.astro";
import Section from "../shared/ui/Section/Section.astro";
import Button from "../shared/ui/Button/Button.astro";
import Card from "../shared/ui/Card/Card.astro";
import { Phone, Mail, Clock, MapPin } from "@lucide/astro";
import { siteConfig } from "../site.config";
import { getContacto } from "../shared/db/contenido";

const title = "Contacto";
const description =
  "Comunícate con el Colegio Piloto: directorio telefónico, formulario de contacto y ubicación.";

// Directorio y campos del formulario desde Supabase (tabla `contenido`), con
// fallback local. Se resuelven en build-time: un cambio del panel aparece
// tras el rebuild.
const contact = await getContacto();

const mapEmbedUrl =
  siteConfig.contact.mapEmbedUrl ||
  "https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3976.1234567890123!2d-74.08175!3d4.60971!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zNMKwMzYnMzUuMCJOIDc0wrAwNCw1NC4zIg!5e0!3m2!1ses!2sco!4v1600000000000";

type FormFieldType = "text" | "email" | "tel" | "textarea";

interface FormField {
  id: string;
  label: string;
  type: FormFieldType;
  required: boolean;
}

const formFields = contact.formFields as FormField[];
---

<BaseLayout title={title} description={description}>
  <Section padding="xl" class="contactHero">
    <div class="contactHero__content">
      <h1 class="contactHero__title">Contacto</h1>
      <p class="contactHero__lead">
        Estamos atentos a resolver tus inquietudes. Escríbenos, llámanos o
        visita nuestras instalaciones.
      </p>
    </div>
  </Section>

  <Section padding="lg" bg="muted">
    <div class="contactGrid">
      <div class="contactDirectory">
        <h2 class="contactDirectory__title">Directorio por departamento</h2>
        <ul class="contactDirectory__list" role="list">
          {
            contact.departments.map((dept) => (
              <li class="contactDirectory__item">
                <Card variant="bordered" class="contactDirectory__card">
                  <h3 class="contactDirectory__name">{dept.name}</h3>
                  <div class="contactDirectory__row">
                    <Phone aria-hidden="true" size={18} />
                    <a
                      href={`tel:${dept.phone.replace(/\s/g, "")}`}
                      class="contactDirectory__link"
                    >
                      {dept.phone}
                    </a>
                  </div>
                  <div class="contactDirectory__row">
                    <Mail aria-hidden="true" size={18} />
                    <a
                      href={`mailto:${dept.email}`}
                      class="contactDirectory__link"
                    >
                      {dept.email}
                    </a>
                  </div>
                  <div class="contactDirectory__row">
                    <Clock aria-hidden="true" size={18} />
                    <span class="contactDirectory__meta">{dept.hours}</span>
                  </div>
                </Card>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="contactForm">
        <h2 class="contactForm__title">Escríbenos</h2>
        <p class="contactForm__lead">
          Completa el formulario y te responderemos lo antes posible.
        </p>
        <form class="contactForm__form" aria-label="Formulario de contacto">
          {
            formFields.map((field) => (
              <div class="contactForm__field">
                <label for={`contact-${field.id}`} class="contactForm__label">
                  {field.label}
                  {field.required && <span aria-hidden="true"> *</span>}
                </label>
                {field.type === "textarea" ? (
                  <textarea
                    id={`contact-${field.id}`}
                    name={field.id}
                    rows={4}
                    required={field.required}
                    class="contactForm__input contactForm__input--textarea"
                  />
                ) : (
                  <input
                    id={`contact-${field.id}`}
                    name={field.id}
                    type={field.type}
                    required={field.required}
                    class="contactForm__input"
                  />
                )}
              </div>
            ))
          }
          <Button type="submit" size="lg" class="contactForm__submit">
            Enviar mensaje
          </Button>
        </form>
      </div>
    </div>
  </Section>

  <Section padding="lg">
    <div class="contactMap">
      <div class="contactMap__header">
        <h2 class="contactMap__title">Ubicación</h2>
        <p class="contactMap__address">
          <MapPin aria-hidden="true" size={18} />
          <span>
            {siteConfig.contact.address}, {siteConfig.contact.city}
          </span>
        </p>
      </div>
      <div class="contactMap__wrapper">
        <iframe
          src={mapEmbedUrl}
          title="Ubicación del Colegio Piloto en Google Maps"
          allowfullscreen
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          class="contactMap__iframe"></iframe>
      </div>
      <div class="contactMap__actions">
        <Button
          href={siteConfig.contact.mapUrl}
          variant="secondary"
          target="_blank"
          rel="noopener noreferrer"
        >
          Cómo llegar
        </Button>
      </div>
    </div>
  </Section>
</BaseLayout>

<style>
  .contactHero__content {
    max-width: 65ch;
  }

  .contactHero__title {
    font-size: var(--text-4xl);
    font-weight: var(--font-weight-bold);
    margin-bottom: var(--space-md);
  }

  @media (min-width: 48rem) {
    .contactHero__title {
      font-size: var(--text-5xl);
    }
  }

  .contactHero__lead {
    font-size: var(--text-lg);
    color: var(--color-text-muted);
  }

  .contactGrid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-2xl);
    align-items: start;
  }

  @media (min-width: 64rem) {
    .contactGrid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .contactDirectory {
    min-width: 0;
  }

  .contactDirectory__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-lg);
  }

  .contactDirectory__list {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .contactDirectory__item {
    min-width: 0;
  }

  .contactDirectory__card {
    gap: var(--space-sm);
  }

  .contactDirectory__name {
    font-size: var(--text-lg);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-xs);
  }

  .contactDirectory__row {
    display: flex;
    align-items: flex-start;
    gap: var(--space-sm);
    color: var(--color-text-muted);
    word-break: break-words;
  }

  .contactDirectory__row svg {
    flex: 0 0 auto;
    margin-top: 0.125rem;
  }

  .contactDirectory__link {
    color: var(--color-primary);
    text-decoration: underline;
    word-break: break-word;
  }

  .contactDirectory__link:hover {
    color: var(--color-primary-hover);
  }

  .contactDirectory__meta {
    word-break: break-words;
  }

  .contactForm {
    min-width: 0;
  }

  .contactForm__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    margin-bottom: var(--space-sm);
  }

  .contactForm__lead {
    color: var(--color-text-muted);
    margin-bottom: var(--space-lg);
  }

  .contactForm__form {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contactForm__field {
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
    min-width: 0;
  }

  .contactForm__label {
    font-size: var(--text-sm);
    font-weight: var(--font-weight-medium);
    color: var(--color-text);
  }

  .contactForm__input {
    width: 100%;
    min-height: 2.75rem;
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
    background-color: var(--color-surface);
    color: var(--color-text);
    transition:
      border-color var(--duration-fast) var(--ease-standard),
      box-shadow var(--duration-fast) var(--ease-standard);
  }

  .contactForm__input:focus-visible {
    outline: none;
    border-color: var(--color-primary);
    box-shadow: 0 0 0 3px var(--color-primary-soft);
  }

  .contactForm__input--textarea {
    min-height: 8rem;
    resize: vertical;
  }

  .contactMap {
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .contactMap__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-sm);
  }

  .contactMap__title {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
  }

  .contactMap__address {
    display: inline-flex;
    align-items: flex-start;
    gap: var(--space-sm);
    color: var(--color-text-muted);
  }

  .contactMap__address svg {
    flex: 0 0 auto;
    margin-top: 0.125rem;
  }

  .contactMap__wrapper {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: var(--radius-lg);
    aspect-ratio: 16 / 9;
    background-color: var(--color-surface-strong);
  }

  .contactMap__iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    max-width: 100%;
    border: 0;
  }

  .contactMap__actions {
    display: flex;
    justify-content: flex-start;
  }
</style>
