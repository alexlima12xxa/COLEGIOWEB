---
// Cimiento de estilos que `BaseLayout` → `global.css` aporta a las páginas
// reales y que esta ruta standalone (sin layout) debe replicar para ser fiel:
// orden de capas (@layer), reset (box-sizing: border-box) y @font-face (Nerko
// One y demás fuentes de banner). Sin esto, el preview cae a sans-serif del
// sistema y el CTA desborda su caja. NO incluye Tailwind (el preview no usa
// utilidades). Las fuentes futuras se registran en _fonts.css → entran solas.
import "../styles/_layers.css";
import "../styles/_reset.css";
import "../styles/_fonts.css";
import HomeBanner from "../features/home/components/HomeBanner/HomeBanner.astro";
import { bannerSchema, type Banner } from "../shared/db/schema";
import { getDbContext } from "../shared/db/client";
import { resolveAssetUrl } from "../shared/db/storage";
import { verifyPreviewToken } from "../shared/lib/preview-token";

/**
 * Ruta híbrida SSR (prerender = false) usada como vista previa del editor de
 * banners del panel admin. Carga el motor de diseño REAL de la web (el
 * despachador HomeBanner + los .astro de plantilla + su CSS), evitando
 * maquetas duplicadas en React/Tailwind.
 *
 * Fuentes de datos (por query param):
 *  - `?datos=<uri-encoded JSON>` → fuente de verdad del BORRADOR en vivo que el
 *    admin envía en cada tecla. Prioritaria.
 *  - `?id=<uuid>` → fallback de conveniencia (modo edición inicial): carga el
 *    banner persistido desde Supabase.
 *
 * Seguridad (guard "seguro por defecto"): requiere `?token=` firmado y vigente
 * (HMAC con `PREVIEW_SIGNING_KEY`, TTL corto). Si falta o es inválido, devuelve
 * 404 en runtime (no falla el build; invisible para bots/escáner).
 */
export const prerender = false;

// Restringe qué sitios pueden embeber esta ruta en un iframe (anti-clickjacking
// del preview). Opt-in: define `ADMIN_ORIGIN` (p. ej.
// https://admin.micolegio.com) en el entorno de la web. Si no se define, no se
// emite el header (comportamiento actual).
const adminOrigin =
  (import.meta.env?.ADMIN_ORIGIN as string | undefined) ??
  process.env.ADMIN_ORIGIN ??
  "";
if (adminOrigin) {
  Astro.response.headers.set(
    "Content-Security-Policy",
    `frame-ancestors 'self' ${adminOrigin}`,
  );
}

// Esta ruta no usa el layout SEOHead (que aporta `<meta charset="utf-8">`), así
// que hay que declarar la codificación explícitamente: Astro sirve el SSR como
// `text/html` sin charset y el navegador caería en un fallback legacy
// (windows-1252), mostrando mojibake en tildes/ñ (p. ej. `á` → `Ã¡`).
Astro.response.headers.set("Content-Type", "text/html; charset=utf-8");

const token = Astro.url.searchParams.get("token");

let banner: Banner | null = null;

if (!verifyPreviewToken(token)) {
  Astro.response.status = 404;
} else {
  const datosParam = Astro.url.searchParams.get("datos");
  const idParam = Astro.url.searchParams.get("id");

  if (datosParam) {
    try {
      // `URLSearchParams.get` ya decodifica el valor; no volver a aplicar
      // `decodeURIComponent` (corrompería textos con `%` literales).
      const parsed = JSON.parse(datosParam);
      const result = bannerSchema.safeParse(parsed);
      if (result.success) banner = result.data;
    } catch {
      banner = null;
    }
  } else if (idParam) {
    const ctx = getDbContext();
    if (ctx) {
      try {
        const { data } = await ctx.client
          .from("banners")
          .select("id, plantillaId:plantilla_id, orden, activo, datos")
          .eq("id", idParam)
          .maybeSingle();

        if (data) {
          const result = bannerSchema.safeParse(data);
          if (result.success) {
            const d = result.data.datos;
            banner = {
              ...result.data,
              datos: {
                ...d,
                background: resolveAssetUrl(d.background) ?? d.background,
                image: resolveAssetUrl(d.image) ?? d.image,
              },
            };
          }
        }
      } catch {
        banner = null;
      }
    }
  }
}
---

<meta charset="utf-8" />
{
  banner ? (
    <HomeBanner banner={banner} />
  ) : (
    <p class="previewAdmin__empty">No hay un banner para previsualizar.</p>
  )
}

<style is:global>
  html,
  body {
    margin: 0;
    padding: 0;
  }

  .previewAdmin__empty {
    margin: 0;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    background: #18181b;
    color: #fafafa;
    font-family: system-ui, sans-serif;
  }
</style>
