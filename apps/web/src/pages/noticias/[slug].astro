---
import { ArrowLeft } from "@lucide/astro";
import BaseLayout from "../../shared/layouts/BaseLayout.astro";
import Section from "../../shared/ui/Section/Section.astro";
import Badge from "../../shared/ui/Badge/Badge.astro";
import ContentImage from "../../shared/ui/ContentImage/ContentImage.astro";
import { getAllNoticias } from "../../shared/db/content";
import { resolveAssetUrl } from "../../shared/db/storage";
import { formatLongDate } from "../../shared/lib/formatDate";
import { renderMarkdown } from "../../shared/lib/markdown";
import { siteConfig } from "../../site.config";
import type { Noticia } from "../../shared/db/schema";

export interface Props {
  noticia: Noticia;
}

export async function getStaticPaths() {
  const noticias = await getAllNoticias();
  return noticias.map((noticia) => ({
    params: { slug: noticia.slug },
    props: { noticia },
  }));
}

const { noticia } = Astro.props;

const title = noticia.titulo;
const description =
  noticia.resumen ?? `Noticia publicada por ${siteConfig.identity.name}.`;
const contentHtml = renderMarkdown(noticia.contenido);
const imageUrl = resolveAssetUrl(noticia.imagenPath);
const ogImage = imageUrl
  ? imageUrl.startsWith("http")
    ? imageUrl
    : new URL(imageUrl, siteConfig.seo.siteUrl).toString()
  : new URL(siteConfig.seo.ogImage, siteConfig.seo.siteUrl).toString();

const pageUrl = new URL(
  `/noticias/${noticia.slug}/`,
  siteConfig.seo.siteUrl,
).toString();

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    {
      "@type": "ListItem",
      position: 1,
      name: "Inicio",
      item: new URL("/", siteConfig.seo.siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 2,
      name: "Noticias",
      item: new URL("/noticias/", siteConfig.seo.siteUrl).toString(),
    },
    {
      "@type": "ListItem",
      position: 3,
      name: noticia.titulo,
      item: pageUrl,
    },
  ],
};

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: noticia.titulo,
  description: noticia.resumen ?? undefined,
  image: ogImage,
  datePublished: noticia.publicadoEn,
  author: {
    "@type": "Organization",
    name: siteConfig.identity.name,
  },
  publisher: {
    "@type": "Organization",
    name: siteConfig.identity.name,
    logo: {
      "@type": "ImageObject",
      url: new URL(
        siteConfig.branding.assets.logo,
        siteConfig.seo.siteUrl,
      ).toString(),
    },
  },
  mainEntityOfPage: pageUrl,
};
---

<BaseLayout
  title={title}
  description={description}
  image={ogImage}
  path={`/noticias/${noticia.slug}`}
>
  <Fragment slot="head">
    <meta property="article:published_time" content={noticia.publicadoEn} />
    {
      imageUrl && (
        <link rel="preload" as="image" href={imageUrl} fetchpriority="high" />
      )
    }
    <script
      type="application/ld+json"
      set:html={JSON.stringify(jsonLd)}
      is:inline
    />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(breadcrumbJsonLd)}
      is:inline
    />
  </Fragment>

  <Section padding="lg">
    <article class="newsDetail">
      <a href="/noticias" class="newsDetail__back">
        <ArrowLeft aria-hidden="true" size={18} />
        Volver a noticias
      </a>

      <header class="newsDetail__header">
        <div class="newsDetail__meta">
          <Badge variant="primary" size="sm">
            {formatLongDate(noticia.publicadoEn)}
          </Badge>
          {
            noticia.autor && (
              <span class="newsDetail__author">Por {noticia.autor}</span>
            )
          }
        </div>
        <h1 class="newsDetail__title">{noticia.titulo}</h1>
      </header>

      {
        imageUrl && (
          <figure class="newsDetail__media">
            <ContentImage
              src={noticia.imagenPath}
              alt={noticia.imagenAlt}
              widths={[640, 1024, 1600]}
              sizes="(min-width: 64rem) 64rem, 100vw"
              loading="eager"
              fetchpriority="high"
              class="newsDetail__image"
            />
          </figure>
        )
      }

      <div class="newsDetail__body" set:html={contentHtml} />
    </article>
  </Section>
</BaseLayout>

<style>
  .newsDetail {
    max-width: var(--container-lg);
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    gap: var(--space-lg);
  }

  .newsDetail__back {
    display: inline-flex;
    align-items: center;
    align-self: flex-start;
    gap: var(--space-xs);
    font-weight: var(--font-weight-medium);
    color: var(--color-primary);
    text-decoration: none;
    padding: var(--space-xs);
    margin: calc(-1 * var(--space-xs));
    border-radius: var(--radius-sm);
  }

  .newsDetail__back:hover {
    text-decoration: underline;
  }

  .newsDetail__back:focus-visible {
    outline: var(--focus-ring-width) solid var(--color-focus);
    outline-offset: var(--focus-ring-offset);
  }

  .newsDetail__header {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 60ch;
  }

  .newsDetail__meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--space-sm);
  }

  .newsDetail__author {
    font-size: var(--text-sm);
    color: var(--color-text-subtle);
  }

  .newsDetail__title {
    font-size: var(--text-3xl);
    font-weight: var(--font-weight-bold);
    line-height: var(--leading-tight);
    word-break: break-words;
  }

  @media (min-width: 48rem) {
    .newsDetail__title {
      font-size: var(--text-5xl);
    }
  }

  .newsDetail__media {
    border-radius: var(--radius-lg);
    overflow: hidden;
    background-color: var(--color-surface-strong);
  }

  /* :global — la clase la aplica ContentImage (hijo) y no hereda el scope;
     sin :global el aspect-ratio 16/9 no aplicaba y la imagen no reservaba
     espacio (CLS 0.27). */
  .newsDetail__media :global(.newsDetail__image) {
    width: 100%;
    max-width: 100%;
    height: auto;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }

  .newsDetail__body {
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
    max-width: 65ch;
    font-size: var(--text-lg);
    line-height: var(--leading-relaxed);
    color: var(--color-text);
  }

  /* :global — el contenido del artículo se inyecta con set:html (markdown),
     así que los elementos hijo no llevan el scope de esta página; sin
     :global estos estilos nunca aplicaban (subrayado de links, headings, etc). */
  .newsDetail__body :global(h2) {
    font-size: var(--text-2xl);
    font-weight: var(--font-weight-semibold);
    margin-top: var(--space-lg);
  }

  .newsDetail__body :global(h3) {
    font-size: var(--text-xl);
    font-weight: var(--font-weight-semibold);
    margin-top: var(--space-md);
  }

  .newsDetail__body :global(p) {
    word-break: break-words;
  }

  .newsDetail__body :global(a) {
    color: var(--color-primary);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .newsDetail__body :global(ul),
  .newsDetail__body :global(ol) {
    padding-left: var(--space-lg);
    display: flex;
    flex-direction: column;
    gap: var(--space-xs);
  }

  .newsDetail__body :global(blockquote) {
    border-left: 4px solid var(--color-primary);
    padding-left: var(--space-md);
    color: var(--color-text-muted);
    font-style: italic;
  }

  .newsDetail__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    font-size: var(--text-base);
  }

  .newsDetail__body :global(th),
  .newsDetail__body :global(td) {
    padding: var(--space-sm) var(--space-md);
    border: 1px solid var(--color-border);
    text-align: left;
  }

  .newsDetail__body :global(th) {
    background-color: var(--color-surface-muted);
    font-weight: var(--font-weight-semibold);
  }
</style>
