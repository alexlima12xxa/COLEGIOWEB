---
import BaseLayout from "../../../shared/layouts/BaseLayout.astro";
import Section from "../../../shared/ui/Section/Section.astro";
import NewsList from "../../../features/noticias/components/NewsList.astro";
import { getNewsPage, NEWS_PER_PAGE } from "../../../shared/db/content";
import { siteConfig } from "../../../site.config";

export async function getStaticPaths() {
  const { totalPages } = await getNewsPage(1, NEWS_PER_PAGE);
  return Array.from({ length: Math.max(0, totalPages - 1) }, (_, index) => ({
    params: { page: String(index + 2) },
  }));
}

const { page: pageParam } = Astro.params;
const pageNumber = Number(pageParam);
const { items, page, totalPages } = await getNewsPage(
  pageNumber,
  NEWS_PER_PAGE,
);

const title = page > 1 ? `Noticias – Página ${page}` : "Noticias";
const description = `Últimas noticias de ${siteConfig.identity.name} (página ${page} de ${totalPages}).`;
---

<BaseLayout
  title={title}
  description={description}
  path={page > 1 ? `/noticias/pagina/${page}` : "/noticias"}
>
  <Section padding="md">
    <h1 class="uVisuallyHidden">Noticias</h1>

    <NewsList items={items} page={page} totalPages={totalPages} />
  </Section>
</BaseLayout>
