---
import BaseLayout from "../../shared/layouts/BaseLayout.astro";
import Section from "../../shared/ui/Section/Section.astro";
import NewsList from "../../features/noticias/components/NewsList.astro";
import { getNewsPage, NEWS_PER_PAGE } from "../../shared/db/content";
import { siteConfig } from "../../site.config";

const { items, page, totalPages } = await getNewsPage(1, NEWS_PER_PAGE);

const title = "Noticias";
const description = `Últimas noticias y novedades de ${siteConfig.identity.name}: actividades, logros y comunicados de la comunidad educativa.`;
---

<BaseLayout title={title} description={description} path="/noticias">
  <Section padding="md">
    <h1 class="uVisuallyHidden">Noticias</h1>

    <NewsList items={items} page={page} totalPages={totalPages} />
  </Section>
</BaseLayout>
