---
import Section from "../../../../shared/ui/Section/Section.astro";
import Badge from "../../../../shared/ui/Badge/Badge.astro";
import Button from "../../../../shared/ui/Button/Button.astro";
import {
  ArrowRight,
  Calendar,
  Clock,
  Info,
  MonitorSmartphone,
  HeartHandshake,
  ShieldCheck,
} from "@lucide/astro";
import "./AdmissionsHero.css";

export interface FechaClave {
  title: string;
  date: string;
  estado: "en-curso" | "ultimos-cupos" | "familias-admitidas";
  description?: string;
}

export interface Props {
  badge: string;
  titlePre: string;
  titleHighlight: string;
  description: string;
  ctaPrimary: { label: string; href: string };
  ctaSecondary: { label: string; href: string };
  fechasClave: FechaClave[];
  aviso?: string;
  class?: string;
}

const {
  badge,
  titlePre,
  titleHighlight,
  description,
  ctaPrimary,
  ctaSecondary,
  fechasClave,
  aviso,
  class: className,
} = Astro.props;

const ESTADOS: Record<
  FechaClave["estado"],
  { label: string; icon: "check" | "clock" | "none" }
> = {
  "en-curso": { label: "En curso", icon: "check" },
  "ultimos-cupos": { label: "Últimos cupos", icon: "clock" },
  "familias-admitidas": { label: "Familias Admitidas", icon: "none" },
};

const trustItems = [
  { label: "Proceso 100% en línea", icon: MonitorSmartphone },
  { label: "Acompañamiento personalizado", icon: HeartHandshake },
  { label: "Privacidad garantizada", icon: ShieldCheck },
];
---

<Section padding="xl" bg="muted" class:list={["admissionsHero", className]}>
  <div class="admissionsHero__grid">
    <div class="admissionsHero__content">
      <Badge variant="success" class="admissionsHero__badge">
        <span class="admissionsHero__badgeDot" aria-hidden="true"></span>
        {badge}
      </Badge>

      <h1 class="admissionsHero__title">
        {titlePre}
        <span class="admissionsHero__titleHighlight">{titleHighlight}</span>
      </h1>

      <p class="admissionsHero__description">{description}</p>

      <div class="admissionsHero__actions">
        <Button
          href={ctaPrimary.href}
          size="lg"
          class="admissionsHero__btnPrimary"
        >
          {ctaPrimary.label}
          <ArrowRight size={18} aria-hidden="true" />
        </Button>
        <Button
          href={ctaSecondary.href}
          variant="secondary"
          size="lg"
          target="_blank"
          rel="noopener noreferrer"
          class="admissionsHero__btnSecondary"
        >
          <svg
            class="admissionsHero__whatsIcon"
            viewBox="0 0 24 24"
            aria-hidden="true"
            width="18"
            height="18"
          >
            <path
              fill="currentColor"
              d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.26.86 5.82 2.42a8.18 8.18 0 0 1 2.42 5.82c0 4.54-3.7 8.23-8.24 8.23-1.48 0-2.93-.39-4.19-1.15l-.3-.17-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24Zm-2.96 3.6c-.18 0-.47.07-.72.34-.25.27-.94.92-.94 2.24 0 1.32.96 2.6 1.1 2.78.13.18 1.88 2.87 4.57 4.02.64.28 1.14.44 1.53.57.64.2 1.22.17 1.68.1.51-.08 1.57-.64 1.79-1.26.22-.62.22-1.15.16-1.26-.07-.11-.25-.18-.51-.31-.27-.13-1.57-.77-1.81-.86-.25-.09-.43-.13-.61.13-.18.27-.69.86-.84 1.03-.16.18-.31.2-.57.07a7.14 7.14 0 0 1-2.12-1.31 7.9 7.9 0 0 1-1.47-1.83c-.15-.27-.02-.41.12-.54.12-.12.27-.31.4-.47.13-.16.18-.27.27-.45.09-.18.04-.34-.02-.47-.07-.13-.61-1.47-.83-2-.21-.52-.43-.45-.61-.46-.16 0-.34-.01-.53-.01Z"
            ></path>
          </svg>
          {ctaSecondary.label}
        </Button>
      </div>

      <ul class="admissionsHero__trust" role="list">
        {
          trustItems.map((item) => (
            <li class="admissionsHero__trustItem">
              <item.icon size={18} aria-hidden="true" />
              <span>{item.label}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <aside class="admissionsHero__card">
      <header class="admissionsHero__cardHeader">
        <span class="admissionsHero__cardIcon" aria-hidden="true">
          <Calendar size={20} />
        </span>
        <h2 class="admissionsHero__cardTitle">Fechas Clave</h2>
        <Badge variant="primary" size="sm" class="admissionsHero__cardBadge">
          Periodo Oficial
        </Badge>
      </header>

      <ul class="admissionsHero__schedule" role="list">
        {
          fechasClave.map((fecha) => {
            const estado = ESTADOS[fecha.estado] ?? ESTADOS["en-curso"];
            return (
              <li class="admissionsHero__scheduleRow">
                <div class="admissionsHero__scheduleText">
                  <span class="admissionsHero__scheduleLabel">
                    {fecha.title}
                  </span>
                  <span class="admissionsHero__scheduleDate">{fecha.date}</span>
                </div>
                <Badge
                  size="sm"
                  class:list={[
                    "admissionsHero__scheduleBadge",
                    `admissionsHero__scheduleBadge--${fecha.estado}`,
                  ]}
                >
                  {estado.icon === "clock" && (
                    <Clock size={12} aria-hidden="true" />
                  )}
                  {estado.label}
                </Badge>
              </li>
            );
          })
        }
      </ul>

      {
        aviso && (
          <div class="admissionsHero__notice">
            <span class="admissionsHero__noticeIcon" aria-hidden="true">
              <Info size={18} />
            </span>
            <p class="admissionsHero__noticeText">{aviso}</p>
          </div>
        )
      }
    </aside>
  </div>
</Section>
