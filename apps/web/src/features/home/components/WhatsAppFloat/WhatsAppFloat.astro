---
import "./WhatsAppFloat.css";
import { siteConfig } from "../../../../site.config";
import { getWhatsapp } from "../../../../shared/db/contenido";

const whatsapp = await getWhatsapp();
const numero = (whatsapp.numero || siteConfig.contact.whatsapp).replace(
  /\D/g,
  "",
);
const href = `https://wa.me/${numero}`;
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  class="whatsappFloat"
  aria-label="Escríbenos por WhatsApp"
>
  <svg
    class="whatsappFloat__icon"
    viewBox="0 0 24 24"
    aria-hidden="true"
    width="26"
    height="26"
  >
    <path
      fill="currentColor"
      d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 1.67c2.2 0 4.26.86 5.82 2.42a8.18 8.18 0 0 1 2.42 5.82c0 4.54-3.7 8.23-8.24 8.23-1.48 0-2.93-.39-4.19-1.15l-.3-.17-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.24 8.24-8.24Zm-2.96 3.6c-.18 0-.47.07-.72.34-.25.27-.94.92-.94 2.24 0 1.32.96 2.6 1.1 2.78.13.18 1.88 2.87 4.57 4.02.64.28 1.14.44 1.53.57.64.2 1.22.17 1.68.1.51-.08 1.57-.64 1.79-1.26.22-.62.22-1.15.16-1.26-.07-.11-.25-.18-.51-.31-.27-.13-1.57-.77-1.81-.86-.25-.09-.43-.13-.61.13-.18.27-.69.86-.84 1.03-.16.18-.31.2-.57.07a7.14 7.14 0 0 1-2.12-1.31 7.9 7.9 0 0 1-1.47-1.83c-.15-.27-.02-.41.12-.54.12-.12.27-.31.4-.47.13-.16.18-.27.27-.45.09-.18.04-.34-.02-.47-.07-.13-.61-1.47-.83-2-.21-.52-.43-.45-.61-.46-.16 0-.34-.01-.53-.01Z"
    ></path>
  </svg>
  <span class="whatsappFloat__label">Informes</span>
</a>
