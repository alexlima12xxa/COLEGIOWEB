---
import type { Banner } from "../../../../../shared/db/schema";
import ResponsiveImage from "../../../../../shared/ui/ResponsiveImage/ResponsiveImage.astro";
import BannerActions from "../BannerActions.astro";
import { fondoMatriculaPorKey } from "@web-modelo/shared";
import "@web-modelo/shared/banners/css/base.css";
import "@web-modelo/shared/banners/css/matricula.css";

/**
 * Plantilla "matricula": dos columnas con kicker + título + subtítulo + CTA a
 * la izquierda y foto a la derecha. El fondo (sección y columna de foto) se
 * elige entre opciones controladas (clave `fondo` → MATRICULA_FONDOS en
 * packages/shared); el resto del diseño es fijo.
 */
export interface Props {
  banner: Banner;
}

const { banner } = Astro.props;
const { datos } = banner;
const fondo = fondoMatriculaPorKey(String(datos.fondo ?? ""));
---

<article
  class="banner banner--matricula"
  style={{ "--banner-bg": fondo.bg, "--banner-foto-bg": fondo.bg }}
>
  <div class="banner__matricula-container">
    <div class="banner__matricula-content">
      {datos.kicker && <span class="banner__matricula-kicker">{datos.kicker}</span>}
      <h1 class="banner__matricula-title">{datos.title}</h1>
      {datos.subtitle && <p class="banner__matricula-subtitle">{datos.subtitle}</p>}
      <BannerActions cta={datos.cta} actions={datos.actions} />
    </div>

    <div class="banner__matricula-foto">
      {
        datos.background ? (
          <ResponsiveImage
            src={datos.background}
            alt={datos.imageAlt || ""}
            width={1280}
            height={720}
            sizes="50vw"
          />
        ) : null
      }
    </div>
  </div>
</article>