---
import type { Banner } from "../../../../../shared/db/schema";
import ResponsiveImage from "../../../../../shared/ui/ResponsiveImage/ResponsiveImage.astro";
import BannerActions from "../BannerActions.astro";
import { tonoCorteDiagonalPorKey } from "@web-modelo/shared";
import "@web-modelo/shared/banners/css/base.css";
import "@web-modelo/shared/banners/css/corte-diagonal.css";

/**
 * Banner "corte-diagonal": panel izquierdo de color sólido con corte diagonal
 * (línea de acento) y foto a la derecha. El director elige el tono del panel
 * entre opciones predefinidas y edita textos, foto y CTA. Posiciones fijas:
 * no hay reposicionamiento.
 */
export interface Props {
  banner: Banner;
}

const { banner } = Astro.props;
const { datos } = banner;
const tono = tonoCorteDiagonalPorKey(String(datos.tono ?? ""));
---

<article
  class="banner banner--corte-diagonal"
  style={{
    "--corte-color": tono.color,
    "--corte-acento": tono.acento,
  }}
>
  <div class="banner__corte-panel">
    <div class="banner__corte-acento" aria-hidden="true"></div>
    <div class="banner__corte-contenido">
      {datos.kicker && <span class="banner__kicker">{datos.kicker}</span>}
      <h1 class="banner__title">{datos.title}</h1>
      {datos.subtitle && <p class="banner__subtitle">{datos.subtitle}</p>}
      <BannerActions cta={datos.cta} actions={datos.actions} />
    </div>
  </div>

  <div class="banner__corte-foto">
    {
      datos.background ? (
        <ResponsiveImage
          src={datos.background}
          alt=""
          width={1600}
          height={1200}
          loading="eager"
          sizes="50vw"
          class="banner__corte-fotoImg"
        />
      ) : (
        <div class="banner__corte-fotoFallback" aria-hidden="true"></div>
      )
    }
  </div>
</article>