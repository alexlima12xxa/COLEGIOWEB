---
import type { Banner } from "../../../../shared/db/schema";
import BannerPrueba from "./templates/BannerPrueba.astro";

/**
 * Despachador de plantillas de banner. Recibe un `Banner` ya resuelto por el
 * repositorio (plantilla_id + datos) y renderiza el componente Astro que
 * corresponde. Cada plantilla es data-agnóstica: el `datos` lleva el payload.
 *
 * Para agregar un banner nuevo: crea el .astro en templates/, añade su entrada
 * al catálogo (packages/shared/src/banners/catalogo.ts), crea su CSS con nombre
 * `<slug>.css` y registra el componente en el mapa de abajo.
 */

export interface Props {
  banner: Banner;
}

const { banner } = Astro.props;
const plantilla = banner.plantillaId;

const COMPONENTES = {
  prueba: BannerPrueba,
} as const;

const Plantilla = COMPONENTES[plantilla as keyof typeof COMPONENTES] ?? null;
---

{Plantilla ? <Plantilla banner={banner} /> : null}
