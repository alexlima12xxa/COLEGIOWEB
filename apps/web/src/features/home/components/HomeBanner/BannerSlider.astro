---
import type { Banner } from "../../../../shared/db/schema";
import HomeBanner from "./HomeBanner.astro";
import "./BannerSlider.css";

/**
 * Slider de banners del hero (full-bleed). Recibe los banners ya resueltos y
 * los muestra como diapositivas con autoplay accesible:
 *  - Pausa en hover/focus y cuando la pestaña no es visible.
 *  - Respeta prefers-reduced-motion (sin autoplay).
 *  - Controles con aria (region/roledescription, dots con aria-label).
 * El contenido (texto) siempre es visible por defecto en CSS: el JS solo
 * sincroniza el avance de diapositivas.
 */
export interface Props {
  banners: Banner[];
}

const { banners } = Astro.props;
---

<section
  class="bannerSlider"
  role="region"
  aria-roledescription="carrusel"
  aria-label="Banners destacados"
>
  <div class="bannerSlider__track" data-banner-track>
    {
      banners.map((banner, index) => (
        <div
          class="bannerSlider__slide"
          data-banner-slide
          role="group"
          aria-roledescription="diapositiva"
          aria-label={`${index + 1} de ${banners.length}`}
        >
          <HomeBanner banner={banner} />
        </div>
      ))
    }
  </div>

  {
    banners.length > 1 && (
      <>
        <button
          type="button"
          class="bannerSlider__arrow bannerSlider__arrow--prev"
          aria-label="Banner anterior"
          data-banner-prev
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="15 18 9 12 15 6" />
          </svg>
        </button>

        <button
          type="button"
          class="bannerSlider__arrow bannerSlider__arrow--next"
          aria-label="Banner siguiente"
          data-banner-next
        >
          <svg
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="9 18 15 12 9 6" />
          </svg>
        </button>

        <div class="bannerSlider__controls">
          <div
            class="bannerSlider__dots"
            role="tablist"
            aria-label="Seleccionar banner"
          >
            {banners.map((_, index) => (
              <button
                type="button"
                class="bannerSlider__dot"
                role="tab"
                aria-selected={index === 0 ? "true" : "false"}
                aria-label={`Ir al banner ${index + 1}`}
                data-banner-dot={index}
              >
                <span class="uVisuallyHidden">Banner {index + 1}</span>
              </button>
            ))}
          </div>
        </div>
      </>
    )
  }

  <button
    type="button"
    class="bannerSlider__scrollHint"
    aria-label="Ver más contenido"
  >
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <polyline points="6 9 12 15 18 9"></polyline>
    </svg>
  </button>
</section>

<script>
  const AUTOPLAY_INTERVAL = 6000;

  function initBannerSlider() {
    const slider = document.querySelector("[data-banner-track]");
    if (!slider || slider.hasAttribute("data-banner-init")) return;
    slider.setAttribute("data-banner-init", "");

    const slides = Array.from(
      slider.querySelectorAll<HTMLElement>("[data-banner-slide]"),
    );
    const dots = Array.from(
      document.querySelectorAll<HTMLButtonElement>("[data-banner-dot]"),
    );
    if (slides.length < 2) return;

    const reduceMotion = window.matchMedia(
      "(prefers-reduced-motion: reduce)",
    ).matches;

    let current = 0;
    let timer: number | undefined;
    let pausedForFocus = false;

    function show(index: number) {
      current = (index + slides.length) % slides.length;
      const track = slider as HTMLElement;
      track.style.transform = `translateX(-${current * 100}%)`;
      dots.forEach((dot, i) => {
        dot.setAttribute("aria-selected", i === current ? "true" : "false");
      });
    }

    function next() {
      show(current + 1);
    }

    function start() {
      if (reduceMotion || pausedForFocus) return;
      stop();
      timer = window.setInterval(next, AUTOPLAY_INTERVAL);
    }

    function stop() {
      if (timer !== undefined) {
        window.clearInterval(timer);
        timer = undefined;
      }
    }

    const prevBtn =
      document.querySelector<HTMLButtonElement>("[data-banner-prev]");
    const nextBtn =
      document.querySelector<HTMLButtonElement>("[data-banner-next]");

    const scrollHint = document.querySelector<HTMLButtonElement>(
      ".bannerSlider__scrollHint",
    );
    scrollHint?.addEventListener("click", () => {
      document.querySelector("#niveles")?.scrollIntoView({
        behavior: "smooth",
        block: "start",
      });
    });

    prevBtn?.addEventListener("click", () => {
      show(current - 1);
      start();
    });
    prevBtn?.addEventListener("focus", () => {
      pausedForFocus = true;
      stop();
    });
    prevBtn?.addEventListener("blur", () => {
      pausedForFocus = false;
      start();
    });

    nextBtn?.addEventListener("click", () => {
      show(current + 1);
      start();
    });
    nextBtn?.addEventListener("focus", () => {
      pausedForFocus = true;
      stop();
    });
    nextBtn?.addEventListener("blur", () => {
      pausedForFocus = false;
      start();
    });

    dots.forEach((dot, index) => {
      dot.addEventListener("click", () => {
        show(index);
        start();
      });
      dot.addEventListener("focus", () => {
        pausedForFocus = true;
        stop();
      });
      dot.addEventListener("blur", () => {
        pausedForFocus = false;
        start();
      });
    });

    slider.addEventListener("mouseenter", stop);
    slider.addEventListener("mouseleave", start);

    document.addEventListener("visibilitychange", () => {
      if (document.hidden) {
        stop();
      } else {
        start();
      }
    });

    start();
  }

  document.addEventListener("astro:page-load", initBannerSlider);
  if (document.readyState !== "loading") initBannerSlider();
</script>
