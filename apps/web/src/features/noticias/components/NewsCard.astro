---
import { ArrowRight, CalendarDays } from "@lucide/astro";
import ContentImage from "../../../shared/ui/ContentImage/ContentImage.astro";
import Logo from "../../../shared/ui/Logo/Logo.astro";
import { formatShortDate } from "../../../shared/lib/formatDate";
import type { Noticia } from "../../../shared/db/schema";
import "./NewsCard.css";

export interface Props {
  noticia: Noticia;
  eager?: boolean;
}

const { noticia, eager = false } = Astro.props;
const href = `/noticias/${noticia.slug}`;
---

<a href={href} class="newsCard">
  <div class="newsCard__thumb">
    {
      noticia.imagenPath ? (
        <ContentImage
          src={noticia.imagenPath}
          alt={noticia.imagenAlt || noticia.titulo}
          widths={[280, 560]}
          sizes="(min-width: 48rem) 140px, 100vw"
          loading={eager ? "eager" : "lazy"}
          class="newsCard__image"
        />
      ) : (
        <div class="newsCard__fallback" aria-hidden="true">
          <Logo iconOnly variant="dark" class="newsCard__fallbackLogo" />
        </div>
      )
    }
  </div>

  <div class="newsCard__body">
    <div class="newsCard__meta">
      <span class="newsCard__metaItem">
        <CalendarDays aria-hidden="true" size={14} />
        <time datetime={noticia.publicadoEn}>
          {formatShortDate(noticia.publicadoEn)}
        </time>
      </span>
      {noticia.autor && <span class="newsCard__dept">{noticia.autor}</span>}
    </div>

    <h3 class="newsCard__title uLineClamp-2">{noticia.titulo}</h3>

    {
      noticia.resumen && (
        <p class="newsCard__resumen uLineClamp-2">{noticia.resumen}</p>
      )
    }

    <span class="newsCard__cta">
      Leer noticia
      <ArrowRight aria-hidden="true" size={16} />
    </span>
  </div>
</a>
