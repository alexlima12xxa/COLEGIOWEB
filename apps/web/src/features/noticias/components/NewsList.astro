---
import type { Noticia } from "../../../shared/db/schema";
import NewsHero from "./NewsHero.astro";
import NewsCard from "./NewsCard.astro";
import NewsPagination from "./NewsPagination.astro";
import "./NewsList.css";

export interface Props {
  items: Noticia[];
  page: number;
  totalPages: number;
}

const { items, page, totalPages } = Astro.props;

const [featured, ...rest] = items;
const showFeatured = page === 1 && Boolean(featured);
const gridItems = showFeatured ? rest : items;
---

{
  items.length > 0 ? (
    <>
      {showFeatured && <NewsHero noticia={featured} />}

      <ul class="newsGrid">
        {gridItems.map((noticia, index) => (
          <li class="newsGrid__item">
            <NewsCard noticia={noticia} eager={index === 0 && !showFeatured} />
          </li>
        ))}
      </ul>

      <NewsPagination page={page} totalPages={totalPages} />
    </>
  ) : (
    <div class="newsGrid__empty">
      <h2 class="newsGrid__emptyTitle">Aún no hay noticias publicadas</h2>
      <p class="newsGrid__emptyText">
        Pronto compartiremos novedades de nuestra institución.
      </p>
    </div>
  )
}
