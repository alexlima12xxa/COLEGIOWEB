---
import "./Input.css";

export interface Props {
  id: string;
  name: string;
  label: string;
  type?: "text" | "email" | "tel" | "textarea" | "select";
  required?: boolean;
  placeholder?: string;
  error?: string;
  options?: Array<{ value: string; label: string }>;
  class?: string;
  autocomplete?: string;
  rows?: number;
}

const {
  id,
  name,
  label,
  type = "text",
  required = false,
  placeholder,
  error,
  options = [],
  class: className,
  autocomplete,
  rows = 4,
} = Astro.props;

const describedBy = error ? `${id}-error` : undefined;
const inputClass = ["input__control", error ? "input__control--error" : ""]
  .filter(Boolean)
  .join(" ");
---

<div class:list={["input", className]}>
  <label for={id} class="input__label">
    {label}
    {
      required && (
        <span class="input__required" aria-hidden="true">
          *
        </span>
      )
    }
  </label>

  {
    type === "textarea" ? (
      <textarea
        id={id}
        name={name}
        class={inputClass}
        required={required}
        placeholder={placeholder}
        aria-describedby={describedBy}
        aria-invalid={error ? "true" : undefined}
        autocomplete={autocomplete}
        rows={rows}
      />
    ) : type === "select" ? (
      <select
        id={id}
        name={name}
        class={inputClass}
        required={required}
        aria-describedby={describedBy}
        aria-invalid={error ? "true" : undefined}
      >
        {options.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    ) : (
      <input
        id={id}
        name={name}
        type={type}
        class={inputClass}
        required={required}
        placeholder={placeholder}
        aria-describedby={describedBy}
        aria-invalid={error ? "true" : undefined}
        autocomplete={autocomplete}
      />
    )
  }

  <span
    id={`${id}-error`}
    class="input__error"
    aria-live="polite"
    hidden={!error}
  >
    {error}
  </span>
</div>
