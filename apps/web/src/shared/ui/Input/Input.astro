---
import "./Input.css";

export interface Props {
  id: string;
  name: string;
  label: string;
  type?: "text" | "email" | "tel" | "textarea" | "select";
  required?: boolean;
  placeholder?: string;
  error?: string;
  options?: Array<{ value: string; label: string }>;
  class?: string;
  autocomplete?: string;
  rows?: number;
  /** Texto corto antepuesto al control (ej. prefijo telefónico "+57"). */
  prefix?: string;
}

const {
  id,
  name,
  label,
  type = "text",
  required = false,
  placeholder,
  error,
  options = [],
  class: className,
  autocomplete,
  rows = 4,
  prefix,
} = Astro.props;

const describedBy = error ? `${id}-error` : undefined;
const inputClass = ["input__control", error ? "input__control--error" : ""]
  .filter(Boolean)
  .join(" ");

const hasPrefix = Boolean(prefix);
---

<div class:list={["input", className]}>
  <label for={id} class="input__label">
    {label}
    {
      required && (
        <span class="input__required" aria-hidden="true">
          *
        </span>
      )
    }
  </label>

  {
    hasPrefix && (
      <div class="input__controlWrapper">
        <span class="input__prefix" aria-hidden="true">
          {prefix}
        </span>
        {type === "select" ? (
          <select
            id={id}
            name={name}
            class:list={[inputClass, "input__control--withPrefix"]}
            required={required}
            aria-describedby={describedBy}
            aria-invalid={error ? "true" : undefined}
          >
            {options.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        ) : (
          <input
            id={id}
            name={name}
            type={type as "text" | "email" | "tel"}
            class:list={[inputClass, "input__control--withPrefix"]}
            required={required}
            placeholder={placeholder}
            aria-describedby={describedBy}
            aria-invalid={error ? "true" : undefined}
            autocomplete={autocomplete}
          />
        )}
      </div>
    )
  }

  {
    !hasPrefix && type === "textarea" ? (
      <textarea
        id={id}
        name={name}
        class={inputClass}
        required={required}
        placeholder={placeholder}
        aria-describedby={describedBy}
        aria-invalid={error ? "true" : undefined}
        autocomplete={autocomplete}
        rows={rows}
      />
    ) : !hasPrefix && type === "select" ? (
      <select
        id={id}
        name={name}
        class={inputClass}
        required={required}
        aria-describedby={describedBy}
        aria-invalid={error ? "true" : undefined}
      >
        {options.map((option) => (
          <option value={option.value}>{option.label}</option>
        ))}
      </select>
    ) : !hasPrefix ? (
      <input
        id={id}
        name={name}
        type={type as "text" | "email" | "tel"}
        class={inputClass}
        required={required}
        placeholder={placeholder}
        aria-describedby={describedBy}
        aria-invalid={error ? "true" : undefined}
        autocomplete={autocomplete}
      />
    ) : null
  }

  <span
    id={`${id}-error`}
    class="input__error"
    aria-live="polite"
    hidden={!error}
  >
    {error}
  </span>
</div>
