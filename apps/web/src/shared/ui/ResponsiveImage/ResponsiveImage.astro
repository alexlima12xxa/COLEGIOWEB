---
import ContentImage from "../ContentImage/ContentImage.astro";
import { resolveAssetUrl } from "../../db/storage";
import "./ResponsiveImage.css";

export interface Props {
  src: string;
  alt: string;
  width?: number;
  height?: number;
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
  sizes?: string;
  widths?: number[];
}

const {
  src,
  alt,
  width,
  height,
  loading = "lazy",
  fetchpriority = "auto",
  class: className,
  sizes = "100vw",
  widths = [480, 768, 1200],
} = Astro.props;

/**
 * Imagen responsiva unificada con ContentImage:
 * - Fuente remota (Supabase Storage, http/https): delega en ContentImage,
 *   que usa <Picture> de astro:assets → AVIF/WebP + srcset + widths.
 * - Ruta local de /public (fallbacks /branding/, placeholders): <img> nativo
 *   con width/height (astro:assets NO procesa /public).
 * - Local en src/: (caso cubierto por ContentImage vía import) — aquí no
 *   aplica porque los assets de branding viven en /public.
 */
const resolved = resolveAssetUrl(src);
const isRemote = resolved ? /^https?:\/\//i.test(resolved) : false;
---

{
  isRemote ? (
    <ContentImage
      src={src}
      alt={alt}
      sizes={sizes}
      widths={widths}
      loading={loading}
      fetchpriority={fetchpriority}
      class={className}
    />
  ) : (
    <img
      src={src}
      alt={alt}
      width={width}
      height={height}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class:list={["responsiveImage", className]}
    />
  )
}
