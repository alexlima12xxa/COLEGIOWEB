---
import "./Card.css";

export interface Props {
  as?: "article" | "div" | "li";
  variant?: "default" | "bordered" | "elevated";
  class?: string;
}

const {
  as: Tag = "article",
  variant = "default",
  class: className,
} = Astro.props;
---

<Tag class:list={["card", `card--${variant}`, className]}>
  <slot />
</Tag>
