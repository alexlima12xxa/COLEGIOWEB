---
import { Picture } from "astro:assets";
import { resolveAssetUrl } from "../../db/storage";
import "./ContentImage.css";

/**
 * Imagen de contenido editorial que puede venir de:
 *  - Supabase Storage (ruta relativa al bucket "media") → Picture con
 *    astro:assets: descarga en build + AVIF/WebP + srcset.
 *  - Ruta local de /public (fallbacks) → <img> nativo (public/ nunca se
 *    procesa por astro:assets).
 *  - Sin imagen → placeholder decorativo (evita saltos de layout).
 */
export interface Props {
  src?: string;
  alt: string;
  sizes?: string;
  widths?: number[];
  loading?: "eager" | "lazy";
  fetchpriority?: "high" | "low" | "auto";
  class?: string;
}

const {
  src,
  alt,
  sizes = "100vw",
  widths = [480, 768, 1200],
  loading = "lazy",
  fetchpriority = "auto",
  class: className,
} = Astro.props;

const resolved = resolveAssetUrl(src);
const isRemote = resolved ? /^https?:\/\//i.test(resolved) : false;

/**
 * Cache a nivel de módulo del resultado de accesibilidad por URL resuelta.
 * Evita repetir requests HEAD por el mismo asset dentro de un mismo build
 * (una noticia se renderiza en card + detalle, y varias noticias pueden
 * compartir placeholder).
 */
const imageAccessCache = new Map<string, boolean>();

/**
 * Comprueba si una URL remota responde con status 2xx (accesible).
 * Solo se considera válido un 2xx: Supabase Storage devuelve 404 para objetos
 * faltantes y 400 para rutas malformadas. Cualquier otro código (o error de
 * red) se trata como inaccesible para no renderizar una imagen rota.
 */
async function isImageAccessible(url: string): Promise<boolean> {
  const cached = imageAccessCache.get(url);
  if (cached !== undefined) return cached;

  let accessible: boolean;
  try {
    const res = await fetch(url, { method: "HEAD" });
    accessible = res.status >= 200 && res.status < 300;
  } catch {
    accessible = false;
  }

  imageAccessCache.set(url, accessible);
  return accessible;
}

// Si la imagen es remota, validamos su accesibilidad en build-time. Si no
// responde, degradamos al placeholder decorativo (evita imagen rota y CLS).
const remoteAccessible =
  resolved && isRemote ? await isImageAccessible(resolved) : true;
---

{
  resolved && isRemote && remoteAccessible ? (
    <Picture
      src={resolved}
      alt={alt}
      inferSize
      formats={["avif", "webp"]}
      widths={widths}
      sizes={sizes}
      fit="cover"
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class:list={["contentImage", className]}
    />
  ) : resolved && !isRemote ? (
    <img
      src={resolved}
      alt={alt}
      loading={loading}
      fetchpriority={fetchpriority}
      decoding="async"
      class:list={["contentImage", className]}
    />
  ) : (
    <div
      class:list={["contentImage", "contentImage--empty", className]}
      aria-hidden="true"
    />
  )
}
